        <relation connection='postgres.1bqfha413n5ejm1b437gy0kdp84f' name='Custom SQL Query' type='text'>SELECT&#13;
    d.day_name,&#13;
    d.day_of_week,&#13;
    t.hour_24,&#13;
    COUNT(*) AS booking_count,&#13;
    ROUND(SUM(f.duration_hours)::numeric, 2) AS booked_hours&#13;
FROM fact_bookings f&#13;
JOIN dim_date d&#13;
    ON f.date_key = d.date_key&#13;
JOIN dim_time t&#13;
    ON f.start_time_key = t.time_key&#13;
GROUP BY&#13;
    d.day_name,&#13;
    d.day_of_week,&#13;
    t.hour_24&#13;
ORDER BY&#13;
    d.day_of_week,&#13;
    t.hour_24</relation>
